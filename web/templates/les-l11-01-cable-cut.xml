<lesson id="les-l11-01-cable-cut" title="A triangle under the sea" level="11" minutes="15" goal="Any one submarine cable can break and all three countries still reach each other"/>
<step n="1" text="Three countries hang on three submarine cables, but CableBC lies dark: both of its ports are turned off. Two cables make a line, not a triangle."/>
<step n="2" text="On CableBC, turn FastEthernet0 and FastEthernet1 on. The triangle closes and OSPF learns the way around."/>
<step n="3" text="A ship drags its anchor through CableAB: country B must still reach the name server the long way, through C." check="c1"/>
<step n="4" text="The same for CableCA: country C goes through B." check="c2"/>
<step n="5" text="And for the cable you just lit: B and C meet through A." check="c3"/>
<step n="6" text="Even the long way, the name server must answer within 200 milliseconds." check="c4"/>
<check id="c1" kind="outage" from="laptopb" to="server0" url="cab:FastEthernet0" expect="ok" label="ResidentCountryB still reaches WorldNameRoot with CableAB cut"/>
<check id="c2" kind="outage" from="laptopc" to="server0" url="cca:FastEthernet0" expect="ok" label="ResidentCountryC still reaches WorldNameRoot with CableCA cut"/>
<check id="c3" kind="outage" from="laptopb" to="laptopc" url="cbc:FastEthernet0" expect="ok" label="ResidentCountryB still reaches ResidentCountryC with CableBC cut"/>
<check id="c4" kind="latency" from="laptopc" to="server0" url="" expect="200" label="WorldNameRoot answers ResidentCountryC in under 200 milliseconds"/>
