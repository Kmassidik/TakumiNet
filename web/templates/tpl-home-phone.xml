  <device id="phone1" kind="phone" model="IP Phone" x="560" y="360" name="DeskPhone" ip="10.30.110.11" prefix="24"/>
  <device id="analog0" kind="analogphone" model="Analog Phone" x="120" y="360" name="HallPhone" ip="" prefix="24"/>
  <link a="router0" a_port="Gig0/0" b="switch0" b_port="Fa0/1" kind="eCopper"/>
  <link a="switch0" a_port="Fa0/2" b="server0" b_port="Fa0" kind="eCopper"/>
  <link a="switch0" a_port="Fa0/3" b="phone1" b_port="Fa0" kind="eCopper"/>
