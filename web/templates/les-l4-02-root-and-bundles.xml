  <link a="c1" a_port="Fa0/23" b="c2" b_port="Fa0/23" kind="eCopper"/>
  <link a="c1" a_port="Fa0/24" b="c2" b_port="Fa0/24" kind="eCopper"/>
  <link a="c1" a_port="Fa0/1" b="a1" b_port="Fa0/1" kind="eCopper"/>
  <link a="c2" a_port="Fa0/1" b="a2" b_port="Fa0/1" kind="eCopper"/>
