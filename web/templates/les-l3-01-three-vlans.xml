<takumi version="1">
  <device id="router0" kind="router" model="2911" x="340" y="60" name="OfficeRouter" ip="" prefix="24"/>
  <device id="switch0" kind="switch" model="2960" x="340" y="200" name="OfficeSwitch" ip="" prefix="24"/>
  <device id="pc0" kind="pc" model="PC-PT" x="60" y="360" name="Desk0" ip="192.168.10.10" prefix="24"/>
  <device id="pc1" kind="pc" model="PC-PT" x="230" y="360" name="Desk1" ip="192.168.10.11" prefix="24"/>
  <device id="pc2" kind="pc" model="PC-PT" x="400" y="360" name="Desk2" ip="192.168.20.10" prefix="24"/>
  <device id="server0" kind="server" model="Server" x="570" y="360" name="FileServer" ip="192.168.20.2" prefix="24"/>
  <device id="printer0" kind="printer" model="Printer" x="740" y="360" name="Printer0" ip="192.168.30.10" prefix="24"/>
  <link a="router0" a_port="Gig0/0" b="switch0" b_port="Fa0/1" kind="eCopper"/>
  <link a="switch0" a_port="Fa0/2" b="pc0" b_port="Fa0" kind="eCopper"/>
  <link a="switch0" a_port="Fa0/3" b="pc1" b_port="Fa0" kind="eCopper"/>
  <link a="switch0" a_port="Fa0/4" b="pc2" b_port="Fa0" kind="eCopper"/>
  <link a="switch0" a_port="Fa0/5" b="server0" b_port="Fa0" kind="eCopper"/>
  <link a="switch0" a_port="Fa0/6" b="printer0" b_port="Fa0" kind="eCopper"/>
  <port id="router0" name="GigabitEthernet0/0.10" up="1" ip="192.168.10.1" prefix="24" vlan="1" trunk="0" dot1q="10" bandwidth_kbps="1000000" delay_us="10"/>
  <port id="router0" name="GigabitEthernet0/0.20" up="1" ip="192.168.20.1" prefix="24" vlan="1" trunk="0" dot1q="20" bandwidth_kbps="1000000" delay_us="10"/>
  <port id="router0" name="GigabitEthernet0/0.30" up="1" ip="192.168.30.1" prefix="24" vlan="1" trunk="0" dot1q="30" bandwidth_kbps="1000000" delay_us="10"/>
  <net id="pc0" gw="192.168.10.1" dns=""/>
  <net id="pc1" gw="192.168.10.1" dns=""/>
  <net id="pc2" gw="192.168.20.1" dns=""/>
  <net id="server0" gw="192.168.20.1" dns=""/>
  <net id="printer0" gw="192.168.30.1" dns=""/>
  <page id="server0" body="Shared files"/>
  <lesson id="les-l3-01-three-vlans" title="Split the office into three VLANs" level="3" minutes="12" goal="Staff, servers and devices each live in their own VLAN and still reach each other through the router"/>
  <step n="1" text="On OfficeSwitch create VLAN 10 named staff, VLAN 20 named servers and VLAN 30 named devices."/>
  <step n="2" text="Put FastEthernet0/2 and FastEthernet0/3 in VLAN 10, FastEthernet0/4 and FastEthernet0/5 in VLAN 20, and FastEthernet0/6 in VLAN 30." check="c1"/>
  <step n="3" text="Make FastEthernet0/1, the cable to the router, a trunk so it carries all three VLANs." check="c4"/>
  <step n="4" text="Ping FileServer from Desk0." check="c5"/>
  <check id="c1" kind="vlan" from="switch0" to="FastEthernet0/2" url="" expect="10" label="Desk0 is in VLAN 10"/>
  <check id="c2" kind="vlan" from="switch0" to="FastEthernet0/4" url="" expect="20" label="Desk2 is in VLAN 20"/>
  <check id="c3" kind="vlan" from="switch0" to="FastEthernet0/6" url="" expect="30" label="The printer is in VLAN 30"/>
  <check id="c4" kind="vlan" from="switch0" to="FastEthernet0/1" url="" expect="trunk" label="The router cable is a trunk"/>
  <check id="c5" kind="ping" from="pc0" to="server0" url="" expect="ok" label="Desk0 reaches FileServer"/>
</takumi>
