<lesson id="les-l7-01-ring-heals" title="Close the city ring" level="7" minutes="15" goal="Any single ring cut still leaves every district reachable"/>
<step n="1" text="Four district hubs sit on one fibre ring, but the segment between DistrictWest and DistrictNorth is still switched off. Ping CityServices from SouthResident: it works, but only one way around."/>
<step n="2" text="Turn on GigabitEthernet0/2 on DistrictWest and GigabitEthernet0/2 on DistrictNorth, so the ring is closed."/>
<step n="3" text="Imagine the North to East fibre breaks. The closed ring must carry the traffic the other way." check="c1"/>
<step n="4" text="Imagine the East to South fibre breaks instead. SouthResident must still reach the city services." check="c2"/>
<check id="c1" kind="outage" from="pc0" to="server0" url="utara:GigabitEthernet0/1" expect="ok" label="SouthResident still reaches CityServices with the North to East fibre cut"/>
<check id="c2" kind="outage" from="pc0" to="server0" url="timur:GigabitEthernet0/2" expect="ok" label="SouthResident still reaches CityServices with the East to South fibre cut"/>
