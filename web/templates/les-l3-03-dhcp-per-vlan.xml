  <lesson id="les-l3-03-dhcp-per-vlan" title="One address server for every VLAN" level="3" minutes="15" goal="Desks in VLAN 10 and VLAN 20 get addresses from FileServer, each from its own network"/>
  <step n="1" text="On FileServer create a DHCP pool for 192.168.20.0/24 with gateway 192.168.20.1, and a second pool for 192.168.10.0/24 with gateway 192.168.10.1." check="c1"/>
  <step n="2" text="Desk0 and Desk1 are in another VLAN, so their broadcast stops at the router. On OfficeRouter subinterface GigabitEthernet0/0.10 set the helper address 192.168.20.2."/>
  <step n="3" text="Switch Desk0, Desk1 and Desk2 to automatic addresses and renew." check="c3"/>
  <step n="4" text="Ping FileServer from Desk0." check="c5"/>
  <check id="c1" kind="pool" from="server0" to="" url="" expect="192.168.20.0/24" label="FileServer has a pool for the servers network"/>
  <check id="c2" kind="pool" from="server0" to="" url="" expect="192.168.10.0/24" label="FileServer has a pool for the staff network"/>
