  <lesson id="les-l4-04-spare-gateway" title="A gateway that survives" level="4" minutes="15" goal="The floor keeps its gateway when the preferred switch goes down"/>
  <step n="1" text="FloorPC points at 172.20.0.1, but no switch answers for that address yet. Ping CampusServer and read the failure."/>
  <step n="2" text="On DistA share the address 172.20.0.1 with priority 110. On DistB share the same address with priority 100." check="c1"/>
  <step n="3" text="DistA answers while it is healthy. Think about DistA's floor port breaking: DistB must take over." check="c2"/>
  <check id="c1" kind="ping" from="pc0" to="server0" url="" expect="ok" label="FloorPC reaches CampusServer through the shared gateway"/>
