<lesson id="les-l8-01-far-village" title="Reach the far villages" level="8" minutes="15" goal="Both villages answer in time and ProsperVillage survives a radio failure"/>
<step n="1" text="Two villages hang off RegencyHub: ProsperVillage over a pair of microwave radios, RemoteVillage over a satellite terminal. Ping RegencyServices from ProsperResident and read the time." check="c1"/>
<step n="2" text="Now ping it from RemoteResident. The satellite hop is long: a quarter of a second each way is normal." check="c2"/>
<step n="3" text="The main radio pair is the only path to ProsperVillage. A spare pair is already mounted: RegencySpareRadio at the hub, ProsperSpareRadio at the village. Join the two spare radios with a copper cable."/>
<step n="4" text="With the spare pair cabled, losing the main radio must not cut the village off." check="c3"/>
<check id="c1" kind="latency" from="pc0" to="server0" url="" expect="20" label="ProsperVillage answers in under 20 milliseconds"/>
<check id="c2" kind="latency" from="pc1" to="server0" url="" expect="600" label="RemoteVillage answers in under 600 milliseconds"/>
<check id="c3" kind="outage" from="pc0" to="server0" url="rh0:GigabitEthernet0/1" expect="ok" label="ProsperVillage still reaches RegencyServices with the main radio link cut"/>
