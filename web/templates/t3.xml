<takumi version="1">
  <device id="homerouter0" kind="homerouter" model="Home Router" x="340" y="120" name="HomeRouter0" ip="" prefix="24"/>
  <device id="laptop0" kind="laptop" model="Laptop" x="100" y="330" name="Laptop0" ip="" prefix="24"/>
  <device id="pc0" kind="pc" model="PC-PT" x="340" y="330" name="PC0" ip="" prefix="24"/>
  <device id="server0" kind="server" model="Server" x="580" y="330" name="Server0" ip="" prefix="24"/>
  <link a="homerouter0" a_port="Fa0" b="laptop0" b_port="Fa0" kind="eCopper"/>
  <link a="homerouter0" a_port="Fa1" b="pc0" b_port="Fa0" kind="eCopper"/>
  <link a="homerouter0" a_port="Fa2" b="server0" b_port="Fa0" kind="eCopper"/>
  <lesson id="t3" title="Home network with automatic addresses" level="1" minutes="10" goal="Laptop0 and PC0 lease addresses and Laptop0 opens Server0's web page"/>
  <step n="1" text="Set Server0 to 192.168.1.2 with mask 255.255.255.0 and gateway 192.168.1.1."/>
  <step n="2" text="On Server0, enable DHCP for 192.168.1.0/24 with gateway 192.168.1.1 and DNS server 192.168.1.2."/>
  <step n="3" text="Select DHCP on Laptop0 and PC0, then renew both leases with ipconfig /renew." check="c1"/>
  <step n="4" text="Open http://192.168.1.2/ in Laptop0's browser." check="c3"/>
  <check id="c1" kind="lease" from="laptop0" to="" url="" expect="" label="Laptop0 has a DHCP lease"/>
  <check id="c2" kind="lease" from="pc0" to="" url="" expect="" label="PC0 has a DHCP lease"/>
  <check id="c3" kind="http" from="laptop0" to="" url="http://192.168.1.2/" expect="Server0" label="Laptop0 opens the home server page"/>
</takumi>
