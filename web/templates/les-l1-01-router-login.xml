  <lesson id="les-l1-01-router-login" title="Sign in to the home router" level="1" minutes="8" goal="Laptop0 signs in with the sticker, and a wrong password is refused"/>
  <step n="1" text="The sticker on HomeRouter0 says: user name admin, password admin."/>
  <step n="2" text="Open the browser on Laptop0 and type 192.168.1.1. The router asks you to sign in."/>
  <step n="3" text="Sign in with the user name and password from the sticker." check="c1"/>
  <step n="4" text="Try a wrong password once and read the message. It must be refused." check="c2"/>
  <check id="c1" kind="login" from="laptop0" to="192.168.1.1" url="admin:admin" expect="ok" label="The router accepts the sticker login"/>
  <check id="c2" kind="login" from="laptop0" to="192.168.1.1" url="admin:letmein" expect="refused" label="The router refuses a wrong password"/>
