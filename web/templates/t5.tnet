<takuminet version="1">
  <device id="switch0" kind="switch" model="2960" x="340" y="130" name="Switch0" ip="" prefix="24"/>
  <device id="pc0" kind="pc" model="PC-PT" x="100" y="330" name="PC0" ip="" prefix="24"/>
  <device id="pc1" kind="pc" model="PC-PT" x="340" y="330" name="PC1" ip="" prefix="24"/>
  <device id="server0" kind="server" model="Server" x="580" y="330" name="Server0" ip="" prefix="24"/>
  <link a="switch0" a_port="Fa0/1" b="pc0" b_port="Fa0" kind="eCopper"/>
  <link a="switch0" a_port="Fa0/2" b="pc1" b_port="Fa0" kind="eCopper"/>
  <link a="switch0" a_port="Fa0/3" b="server0" b_port="Fa0" kind="eCopper"/>
  <lesson id="t5" title="Visit a website by name" level="2" minutes="10" goal="PC0 resolves www.takumi.lab and opens the website"/>
  <step n="1" text="Set Server0 to 192.168.1.100/24. Address PC0 as 192.168.1.10/24 and PC1 as 192.168.1.11/24."/>
  <step n="2" text="On Server0, add a DNS A record for www.takumi.lab pointing to 192.168.1.100."/>
  <step n="3" text="Set the DNS server on both PCs to 192.168.1.100."/>
  <step n="4" text="Run nslookup www.takumi.lab on PC0, then open http://www.takumi.lab/ in its browser." check="c1"/>
  <check id="c1" kind="http" from="pc0" to="" url="http://www.takumi.lab/" expect="Server0" label="PC0 opens the website by name"/>
  <check id="c2" kind="nslookup" from="pc0" to="www.takumi.lab" url="" expect="192.168.1.100" label="nslookup resolves www.takumi.lab to the server"/>
</takuminet>
