<link a="router3" a_port="Gig0/2" b="server0" b_port="Fa0" kind="eCross"/>
<lesson id="les-l4-03-ospf-campus" title="Join the campus with OSPF" level="4" minutes="15" goal="PC0 reaches Server0, and still does after one uplink is cut"/>
<step n="1" text="Four routers are addressed but do not know each other's networks. Ping Server0 from PC0 and read the failure."/>
<step n="2" text="On every router enable OSPF process 1 and announce the six networks: 192.168.1.0, 192.168.2.0 and 10.0.1.0 to 10.0.4.0, all in area 0."/>
<step n="3" text="Check that Router0 now has a route to 192.168.2.0/24." check="c1"/>
<step n="4" text="Ping Server0 from PC0." check="c2"/>
<step n="5" text="Think about the cable between Router0 and Router1. If it breaks, does PC0 still reach Server0?" check="c3"/>
<check id="c1" kind="route" from="router0" to="" url="" expect="192.168.2.0/24" label="Router0 has a route to the server network"/>
<check id="c2" kind="ping" from="pc0" to="server0" url="" expect="ok" label="PC0 reaches Server0"/>
<check id="c3" kind="outage" from="pc0" to="server0" url="router0:GigabitEthernet0/1" expect="ok" label="PC0 still reaches Server0 with the Router0 to Router1 cable cut"/>
</takumi>
