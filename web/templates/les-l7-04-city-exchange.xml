<lesson id="les-l7-04-city-exchange" title="Two providers, one exchange" level="7" minutes="15" goal="Traffic between the two providers' districts flows through SentralKota"/>
<step n="1" text="Two providers each serve a district of the same city. PenyediaFajar already peers with SentralKota and announces its district. Ping PelangganSenja from PelangganFajar and read the failure: the exchange has no route to the other district yet." check="c1"/>
<step n="2" text="On PenyediaSenja set the local autonomous system to 64702."/>
<step n="3" text="Add the neighbor 10.70.8.5 in autonomous system 64700. The session to SentralKota comes up." check="c2"/>
<step n="4" text="Announce the district network 192.168.77.0/24. SentralKota learns it, and traffic between the two providers now stays inside the city." check="c3"/>
<step n="5" text="Ping PelangganSenja from PelangganFajar again. The packet crosses the exchange, never a far-away transit." check="c4"/>
<check id="c1" kind="bgp" from="isp1" to="10.70.8.1" url="" expect="established" label="PenyediaFajar holds its session at the exchange"/>
<check id="c2" kind="bgp" from="isp2" to="10.70.8.5" url="" expect="established" label="PenyediaSenja holds its session at the exchange"/>
<check id="c3" kind="route" from="cx0" to="" url="" expect="192.168.77.0/24" label="SentralKota carries the route to PenyediaSenja's district"/>
<check id="c4" kind="ping" from="pca" to="pcb" url="" expect="ok" label="PelangganFajar reaches PelangganSenja through the exchange"/>
</takumi>
