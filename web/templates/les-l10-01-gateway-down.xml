<lesson id="les-l10-01-gateway-down" title="When the national gateway fails" level="10" minutes="15" goal="The two provinces still reach each other when a cable at GerbangJakarta is cut, and the overseas page stays under 120 milliseconds"/>
<step n="1" text="Both provinces hang off GerbangJakarta. The direct cable between PopSulawesi and PopJawa is plugged in, but its two ports are turned off: today every inland packet crosses the gateway."/>
<step n="2" text="On PopSulawesi, turn port GigabitEthernet0/2 on. Do the same for GigabitEthernet0/2 on PopJawa. OSPF now knows a second inland path."/>
<step n="3" text="Cut the gateway side of Sulawesi in your head: the two provinces must still see each other." check="c1"/>
<step n="4" text="And the gateway side of Jawa too." check="c2"/>
<step n="5" text="The page across the sea must stay quick enough to read." check="c3"/>
<check id="c1" kind="outage" from="laptop0" to="pcjawa" url="gw0:GigabitEthernet0/0" expect="ok" label="WargaSulawesi still reaches WargaJawa with the gateway cable to PopSulawesi cut"/>
<check id="c2" kind="outage" from="laptop0" to="pcjawa" url="gw0:GigabitEthernet0/1" expect="ok" label="WargaSulawesi still reaches WargaJawa with the gateway cable to PopJawa cut"/>
<check id="c3" kind="latency" from="laptop0" to="server0" url="" expect="120" label="The overseas server answers in under 120 milliseconds"/>
