<lesson id="les-l10-02-cache-saves-cables" title="A cache saves the cables" level="10" minutes="15" goal="The popular page is served from inside the country far faster than the overseas copy"/>
<step n="1" text="Every evening the whole city opens the same page from OverseasOrigin, and every request crosses SeaCable twice. A copy of the page already waits on ContentCache, one street from PopCity, with no cable to its name."/>
<step n="2" text="Run a crossover cable from GigabitEthernet0/2 on PopCity to ContentCache. The cache joins the network and the name cache.content.lab leads to it."/>
<step n="3" text="Open http://cache.content.lab/ from CityResident. The page now comes from one street away." check="c1"/>
<step n="4" text="Read the difference in delay: the cache answers in city time." check="c2"/>
<step n="5" text="The overseas original still works, but every byte pays the sea crossing." check="c3"/>
<check id="c1" kind="http" from="laptop0" to="" url="http://cache.content.lab/" expect="ContentCache" label="The cached page opens from inside the country"/>
<check id="c2" kind="latency" from="laptop0" to="cache0" url="" expect="5" label="The cache answers in under 5 milliseconds"/>
<check id="c3" kind="latency" from="laptop0" to="origin0" url="" expect="150" label="The overseas original stays within 150 milliseconds"/>
